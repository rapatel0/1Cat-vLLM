"""Benchmark truthful q>1 segmented attention at Hy3's TP8-local shape.

The default workload is one independently resident 64K request with MTP2
verification (q=3, Hq/Hkv=8/1, D=128). Unlike earlier exploratory harnesses,
this benchmark passes the real query length to production dispatch and sizes
all segmented scratch by flattened query-token rows.
"""

from __future__ import annotations

import argparse
import hashlib
import json
import math
import os
import statistics
import subprocess
import sys
from contextlib import contextmanager
from dataclasses import asdict, dataclass, field
from pathlib import Path

import torch

from vllm.v1.attention.ops import (
    triton_unified_attention as triton_unified_attention_module,
)
from vllm.v1.kv_cache_interface import KVQuantMode

_can_use_3d_attention = triton_unified_attention_module._can_use_3d_attention
unified_attention = triton_unified_attention_module.unified_attention


@dataclass(frozen=True)
class Candidate:
    name: str
    segments: int
    warps: int
    block_m: int

    @property
    def segmented(self) -> bool:
        return self.segments > 0


@dataclass(frozen=True)
class ErrorStats:
    maximum: float
    p99: float
    mean: float


@dataclass(frozen=True)
class Result:
    candidate: str
    planned_segmented: bool
    scratch_touched: bool
    scratch_validation_complete: bool
    backend_selectable: bool
    segments: int
    warps: int
    block_m: int
    median_ms: float
    mad_ms: float
    minimum_ms: float
    maximum_ms: float
    samples_ms: list[float]
    speedup_vs_2d: float | None
    error_vs_fp32: ErrorStats
    error_vs_2d: ErrorStats
    within_2d_fp32_envelope: bool
    valid: bool
    invalid_reasons: list[str]


@dataclass
class CandidateState:
    candidate: Candidate
    output: torch.Tensor
    scratch: tuple[torch.Tensor, torch.Tensor, torch.Tensor]
    samples: list[float] = field(default_factory=list)


@contextmanager
def _sm70_schedule(candidate: Candidate):
    keys = (
        "VLLM_SM70_TRITON_ATTN_DECODE_NUM_WARPS",
        "VLLM_SM70_TRITON_ATTN_PREFILL_NUM_WARPS",
    )
    previous = {key: os.environ.get(key) for key in keys}
    try:
        if candidate.segmented:
            os.environ[keys[0]] = str(candidate.warps)
        else:
            os.environ.pop(keys[0], None)
            os.environ.pop(keys[1], None)
        yield
    finally:
        for key, value in previous.items():
            if value is None:
                os.environ.pop(key, None)
            else:
                os.environ[key] = value


def _parse_positive_csv(raw: str, name: str) -> list[int]:
    values = [int(value) for value in raw.split(",")]
    if not values or any(value <= 0 for value in values):
        raise ValueError(f"{name} must contain positive comma-separated integers")
    return values


def _parse_candidates(raw: str) -> list[Candidate]:
    candidates: list[Candidate] = []
    for value in raw.split(","):
        if value == "2d":
            candidates.append(Candidate(name="2d", segments=0, warps=0, block_m=16))
            continue
        pieces = value.split("x")
        if len(pieces) not in (2, 3):
            raise ValueError(
                f"Invalid candidate {value!r}; expected "
                "2d, SEGMENTSxWARPS, or SEGMENTSxWARPSxBLOCK_M"
            )
        segments_raw, warps_raw = pieces[:2]
        segments = int(segments_raw)
        warps = int(warps_raw)
        block_m = int(pieces[2]) if len(pieces) == 3 else 16
        if (
            segments not in (16, 32, 64)
            or warps not in (1, 2, 4, 8)
            or block_m not in (16, 32)
        ):
            raise ValueError(
                f"Invalid candidate {value!r}; expected "
                "segments in 16/32/64, "
                "warps in 1/2/4/8, "
                "block_m in 16/32"
            )
        candidates.append(
            Candidate(
                name=f"segmented_s{segments}_w{warps}_m{block_m}",
                segments=segments,
                warps=warps,
                block_m=block_m,
            )
        )
    if not any(not candidate.segmented for candidate in candidates):
        candidates.insert(
            0,
            Candidate(name="2d", segments=0, warps=0, block_m=16),
        )
    names = [candidate.name for candidate in candidates]
    if len(names) != len(set(names)):
        raise ValueError("Candidate list contains duplicate routes")
    if len(candidates) > 5:
        raise ValueError("Use at most one baseline and four progressive candidates")
    return candidates


def _make_inputs(
    *,
    seq_lens: list[int],
    query_lens: list[int],
    query_heads: int,
    kv_heads: int,
    head_size: int,
    block_size: int,
    seed: int,
) -> tuple[
    torch.Tensor,
    torch.Tensor,
    torch.Tensor,
    torch.Tensor,
    torch.Tensor,
    torch.Tensor,
]:
    if len(seq_lens) != len(query_lens):
        raise ValueError("seq_lens and query_lens must have equal lengths")
    generator = torch.Generator(device="cuda")
    generator.manual_seed(seed)

    blocks_per_seq = [(seq_len + block_size - 1) // block_size for seq_len in seq_lens]
    used_blocks = sum(blocks_per_seq)
    physical_block_count = used_blocks + 2
    query = torch.randn(
        (sum(query_lens), query_heads, head_size),
        dtype=torch.float16,
        device="cuda",
        generator=generator,
    )
    key_cache = torch.full(
        (physical_block_count, block_size, kv_heads, head_size),
        float("nan"),
        dtype=torch.float16,
        device="cuda",
    )
    value_cache = torch.full(
        (physical_block_count, block_size, kv_heads, head_size),
        float("nan"),
        dtype=torch.float16,
        device="cuda",
    )

    shuffled_blocks = torch.randperm(
        physical_block_count,
        dtype=torch.int64,
        device="cuda",
        generator=generator,
    ).to(torch.int32)
    active_pages = shuffled_blocks[:used_blocks].long()
    key_cache[active_pages] = torch.randn(
        (used_blocks, block_size, kv_heads, head_size),
        dtype=torch.float16,
        device="cuda",
        generator=generator,
    )
    value_cache[active_pages] = torch.randn(
        (used_blocks, block_size, kv_heads, head_size),
        dtype=torch.float16,
        device="cuda",
        generator=generator,
    )
    max_blocks = max(blocks_per_seq)
    block_table = shuffled_blocks[-1].expand(len(seq_lens), max_blocks + 1).clone()
    offset = 0
    for seq_idx, (seq_len, block_count) in enumerate(zip(seq_lens, blocks_per_seq)):
        block_table[seq_idx, :block_count] = shuffled_blocks[
            offset : offset + block_count
        ]
        valid_tail = seq_len % block_size
        if valid_tail:
            final_page = shuffled_blocks[offset + block_count - 1].long()
            key_cache[final_page, valid_tail:] = float("nan")
            value_cache[final_page, valid_tail:] = float("nan")
        offset += block_count

    seq_lens_tensor = torch.tensor(seq_lens, dtype=torch.int32, device="cuda")
    cu_seqlens_q = torch.tensor(
        [0, *query_lens],
        dtype=torch.int32,
        device="cuda",
    ).cumsum(dim=0)
    return (
        query,
        key_cache,
        value_cache,
        block_table,
        seq_lens_tensor,
        cu_seqlens_q,
    )


def _make_scratch(
    query: torch.Tensor,
    segments: int,
) -> tuple[torch.Tensor, torch.Tensor, torch.Tensor]:
    effective_segments = max(segments, 1)
    return (
        torch.full(
            (
                query.shape[0],
                query.shape[1],
                effective_segments,
                query.shape[2],
            ),
            float("nan"),
            dtype=torch.float32,
            device=query.device,
        ),
        torch.full(
            (query.shape[0], query.shape[1], effective_segments),
            float("nan"),
            dtype=torch.float32,
            device=query.device,
        ),
        torch.full(
            (query.shape[0], query.shape[1], effective_segments),
            float("nan"),
            dtype=torch.float32,
            device=query.device,
        ),
    )


def _run(
    *,
    candidate: Candidate,
    query: torch.Tensor,
    key_cache: torch.Tensor,
    value_cache: torch.Tensor,
    output: torch.Tensor,
    block_table: torch.Tensor,
    seq_lens: torch.Tensor,
    cu_seqlens_q: torch.Tensor,
    query_lens: list[int],
    max_seq_len: int,
    scratch: tuple[torch.Tensor, torch.Tensor, torch.Tensor],
) -> torch.Tensor:
    unified_attention(
        q=query,
        k=key_cache,
        v=value_cache,
        out=output,
        cu_seqlens_q=cu_seqlens_q,
        max_seqlen_q=max(query_lens),
        seqused_k=seq_lens,
        max_seqlen_k=max_seq_len,
        softmax_scale=query.shape[-1] ** -0.5,
        causal=True,
        window_size=(-1, -1),
        block_table=block_table,
        softcap=0.0,
        q_descale=None,
        k_descale=None,
        v_descale=None,
        seq_threshold_3D=query.shape[0] if candidate.segmented else 0,
        num_par_softmax_segments=(candidate.segments if candidate.segmented else 1),
        softmax_segm_output=scratch[0],
        softmax_segm_max=scratch[1],
        softmax_segm_expsum=scratch[2],
        kv_quant_mode=KVQuantMode.NONE,
        sm70_mtp_block_m=(
            candidate.block_m if candidate.segmented and candidate.block_m != 16 else 0
        ),
    )
    return output


def _benchmark_candidates(
    *,
    candidates: list[Candidate],
    query: torch.Tensor,
    key_cache: torch.Tensor,
    value_cache: torch.Tensor,
    block_table: torch.Tensor,
    seq_lens: torch.Tensor,
    cu_seqlens_q: torch.Tensor,
    query_lens: list[int],
    max_seq_len: int,
    warmups: int,
    repeats: int,
) -> list[tuple[Candidate, torch.Tensor, list[float], bool, bool]]:
    states = [
        CandidateState(
            candidate=candidate,
            output=torch.empty_like(query),
            scratch=_make_scratch(query, candidate.segments),
        )
        for candidate in candidates
    ]
    for state in states:
        with _sm70_schedule(state.candidate):
            for _ in range(warmups):
                _run(
                    candidate=state.candidate,
                    query=query,
                    key_cache=key_cache,
                    value_cache=value_cache,
                    output=state.output,
                    block_table=block_table,
                    seq_lens=seq_lens,
                    cu_seqlens_q=cu_seqlens_q,
                    query_lens=query_lens,
                    max_seq_len=max_seq_len,
                    scratch=state.scratch,
                )
    torch.cuda.synchronize()

    for repeat_idx in range(repeats):
        ordered_states = states if repeat_idx % 2 == 0 else list(reversed(states))
        round_events: list[
            tuple[CandidateState, torch.cuda.Event, torch.cuda.Event]
        ] = []
        for state in ordered_states:
            start = torch.cuda.Event(enable_timing=True)
            end = torch.cuda.Event(enable_timing=True)
            with _sm70_schedule(state.candidate):
                start.record()
                _run(
                    candidate=state.candidate,
                    query=query,
                    key_cache=key_cache,
                    value_cache=value_cache,
                    output=state.output,
                    block_table=block_table,
                    seq_lens=seq_lens,
                    cu_seqlens_q=cu_seqlens_q,
                    query_lens=query_lens,
                    max_seq_len=max_seq_len,
                    scratch=state.scratch,
                )
                end.record()
            round_events.append((state, start, end))
        torch.cuda.synchronize()
        for state, start, end in round_events:
            state.samples.append(float(start.elapsed_time(end)))

    # Timed state is never correctness evidence. Poison every destination and
    # run one dedicated validation launch so stale or partial writes fail.
    for state in states:
        state.output.fill_(float("nan"))
        for scratch_tensor in state.scratch:
            scratch_tensor.fill_(float("nan"))
        with _sm70_schedule(state.candidate):
            _run(
                candidate=state.candidate,
                query=query,
                key_cache=key_cache,
                value_cache=value_cache,
                output=state.output,
                block_table=block_table,
                seq_lens=seq_lens,
                cu_seqlens_q=cu_seqlens_q,
                query_lens=query_lens,
                max_seq_len=max_seq_len,
                scratch=state.scratch,
            )
    torch.cuda.synchronize()

    return [
        (
            state.candidate,
            state.output.clone(),
            state.samples,
            bool(torch.isfinite(state.scratch[1]).any().item()),
            (
                all(
                    bool(torch.isfinite(tensor).all().item())
                    for tensor in state.scratch
                )
                and bool((state.scratch[2] > 0).all().item())
                if state.candidate.segmented
                else all(
                    bool(torch.isnan(tensor).all().item()) for tensor in state.scratch
                )
            ),
        )
        for state in states
    ]


def _fp32_reference(
    *,
    query: torch.Tensor,
    key_cache: torch.Tensor,
    value_cache: torch.Tensor,
    block_table: torch.Tensor,
    seq_lens: list[int],
    query_lens: list[int],
) -> torch.Tensor:
    block_size = key_cache.shape[1]
    kv_heads = key_cache.shape[2]
    head_size = key_cache.shape[3]
    repeats = query.shape[1] // kv_heads
    outputs: list[torch.Tensor] = []
    query_offset = 0
    for seq_idx, (seq_len, query_len) in enumerate(zip(seq_lens, query_lens)):
        block_count = (seq_len + block_size - 1) // block_size
        physical_blocks = block_table[seq_idx, :block_count].long()
        key = key_cache[physical_blocks].flatten(0, 1)[:seq_len].float()
        value = value_cache[physical_blocks].flatten(0, 1)[:seq_len].float()
        query_slice = query[query_offset : query_offset + query_len].float()
        query_grouped = query_slice.view(
            query_len,
            kv_heads,
            repeats,
            head_size,
        ).permute(1, 2, 0, 3)
        scores = torch.einsum(
            "grqd,kgd->grqk",
            query_grouped,
            key,
        )
        scores *= head_size**-0.5
        key_positions = torch.arange(seq_len, device=query.device)
        query_positions = (
            seq_len
            - query_len
            + torch.arange(
                query_len,
                device=query.device,
            )
        )
        causal_mask = key_positions[None, :] > query_positions[:, None]
        scores.masked_fill_(causal_mask[None, None, :, :], float("-inf"))
        probabilities = torch.softmax(scores, dim=-1)
        output = torch.einsum(
            "grqk,kgd->qgrd",
            probabilities,
            value,
        ).reshape(query_len, query.shape[1], head_size)
        outputs.append(output)
        query_offset += query_len
    return torch.cat(outputs)


def _error_stats(actual: torch.Tensor, expected: torch.Tensor) -> ErrorStats:
    error = (actual.float() - expected.float()).abs().flatten()
    return ErrorStats(
        maximum=float(error.max().item()),
        p99=float(torch.quantile(error, 0.99).item()),
        mean=float(error.mean().item()),
    )


def _median_abs_deviation(samples: list[float]) -> float:
    median = statistics.median(samples)
    return float(statistics.median(abs(sample - median) for sample in samples))


def _repo_root() -> Path:
    return Path(__file__).resolve().parents[1]


def _loaded_source_path() -> Path:
    module_path = triton_unified_attention_module.__file__
    if module_path is None:
        raise RuntimeError("Loaded unified-attention module has no source path")
    return Path(module_path).resolve()


def _validate_loaded_source() -> None:
    expected = (
        _repo_root() / "vllm/v1/attention/ops/triton_unified_attention.py"
    ).resolve()
    loaded = _loaded_source_path()
    if loaded != expected:
        raise RuntimeError(
            "Benchmark source/import mismatch: "
            f"expected {expected}, loaded {loaded}. "
            "Run with this checkout first on PYTHONPATH."
        )


def _source_sha() -> str:
    result = subprocess.run(
        ["git", "rev-parse", "HEAD"],
        check=True,
        capture_output=True,
        text=True,
        cwd=_repo_root(),
    )
    return result.stdout.strip()


def _source_dirty() -> bool:
    result = subprocess.run(
        ["git", "status", "--porcelain"],
        check=True,
        capture_output=True,
        text=True,
        cwd=_repo_root(),
    )
    return bool(result.stdout.strip())


def _source_hashes() -> dict[str, str]:
    root = _repo_root()
    relative_paths = (
        "benchmarks/benchmark_hy3_64k_segmented_attention.py",
        "vllm/v1/attention/backends/triton_attn.py",
        "vllm/v1/attention/ops/triton_unified_attention.py",
    )
    return {
        path: hashlib.sha256((root / path).read_bytes()).hexdigest()
        for path in relative_paths
    }


def _parse_args() -> argparse.Namespace:
    parser = argparse.ArgumentParser()
    parser.add_argument("--json-out", type=Path, required=True)
    parser.add_argument("--seq-lens", default="65536")
    parser.add_argument("--query-lens", default="3")
    parser.add_argument("--query-heads", type=int, default=8)
    parser.add_argument("--kv-heads", type=int, default=1)
    parser.add_argument("--head-size", type=int, default=128)
    parser.add_argument("--block-size", type=int, default=16)
    parser.add_argument(
        "--candidates",
        default="2d,16x8,32x8,32x4x32,64x4x32",
    )
    parser.add_argument("--warmups", type=int, default=10)
    parser.add_argument("--repeats", type=int, default=31)
    parser.add_argument("--seed", type=int, default=20260718)
    parser.add_argument("--max-abs-error", type=float, default=3e-2)
    parser.add_argument("--p99-abs-error", type=float, default=1e-2)
    parser.add_argument("--mean-abs-error", type=float, default=3e-3)
    parser.add_argument("--baseline-envelope-slack", type=float, default=1.0)
    parser.add_argument(
        "--require-clean-source",
        action="store_true",
        help="Fail unless every tracked and untracked source path is clean.",
    )
    return parser.parse_args()


def main() -> int:
    args = _parse_args()
    _validate_loaded_source()
    if args.warmups < 1 or args.repeats < 5:
        raise ValueError("Use at least one warmup and five timed repeats")
    declared_limits = (
        (args.max_abs_error, 3e-2, "max_abs_error"),
        (args.p99_abs_error, 1e-2, "p99_abs_error"),
        (args.mean_abs_error, 3e-3, "mean_abs_error"),
    )
    for actual, maximum, name in declared_limits:
        if actual <= 0 or actual > maximum:
            raise ValueError(f"{name} must be in (0, {maximum}]")
    if not 0 < args.baseline_envelope_slack <= 1:
        raise ValueError("baseline_envelope_slack must be in (0, 1]")
    if not torch.cuda.is_available():
        raise RuntimeError("CUDA is required")
    if torch.cuda.get_device_capability() != (7, 0):
        raise RuntimeError("This benchmark requires an SM70 GPU")

    seq_lens = _parse_positive_csv(args.seq_lens, "seq_lens")
    query_lens = _parse_positive_csv(args.query_lens, "query_lens")
    if len(seq_lens) != len(query_lens):
        raise ValueError("seq_lens and query_lens must have equal lengths")
    if (
        args.query_heads,
        args.kv_heads,
        args.head_size,
        args.block_size,
    ) != (8, 1, 128, 16):
        raise ValueError(
            "This campaign benchmark is restricted to Hy3's TP8-local "
            "Hq/Hkv/D/block=8/1/128/16 shape"
        )
    if len(seq_lens) not in (1, 2):
        raise ValueError("This campaign benchmark supports batch size 1 or 2")
    if any(query_len not in (2, 3, 4) for query_len in query_lens):
        raise ValueError("MTP query lengths must be in 2..4")
    if any(seq_len < 4096 for seq_len in seq_lens):
        raise ValueError("Campaign performance cases must use at least 4K context")
    if any(query_len > seq_len for query_len, seq_len in zip(query_lens, seq_lens)):
        raise ValueError(
            "Each query length must be no greater than its sequence length"
        )
    candidates = _parse_candidates(args.candidates)
    (
        query,
        key_cache,
        value_cache,
        block_table,
        seq_lens_tensor,
        cu_seqlens_q,
    ) = _make_inputs(
        seq_lens=seq_lens,
        query_lens=query_lens,
        query_heads=args.query_heads,
        kv_heads=args.kv_heads,
        head_size=args.head_size,
        block_size=args.block_size,
        seed=args.seed,
    )
    reference = _fp32_reference(
        query=query,
        key_cache=key_cache,
        value_cache=value_cache,
        block_table=block_table,
        seq_lens=seq_lens,
        query_lens=query_lens,
    )

    raw_results = _benchmark_candidates(
        candidates=candidates,
        query=query,
        key_cache=key_cache,
        value_cache=value_cache,
        block_table=block_table,
        seq_lens=seq_lens_tensor,
        cu_seqlens_q=cu_seqlens_q,
        query_lens=query_lens,
        max_seq_len=max(seq_lens),
        warmups=args.warmups,
        repeats=args.repeats,
    )

    baseline_entry = next(entry for entry in raw_results if not entry[0].segmented)
    baseline_output = baseline_entry[1]
    baseline_median = statistics.median(baseline_entry[2])
    baseline_error = _error_stats(baseline_output, reference)
    results: list[Result] = []
    for (
        candidate,
        output,
        samples,
        scratch_touched,
        scratch_validation_complete,
    ) in raw_results:
        candidate_error = _error_stats(output, reference)
        scratch = _make_scratch(query, candidate.segments)
        planned_segmented = _can_use_3d_attention(
            max_seqlen_q=max(query_lens),
            num_query_tokens=query.shape[0],
            num_seqs=len(seq_lens),
            num_query_heads=query.shape[1],
            head_size_padded=query.shape[2],
            query_device=query.device,
            seq_threshold_3d=query.shape[0] if candidate.segmented else 0,
            num_segments=candidate.segments if candidate.segmented else 1,
            softmax_segm_output=scratch[0],
            softmax_segm_max=scratch[1],
            softmax_segm_expsum=scratch[2],
            multi_query_supported=(
                args.query_heads == 8
                and args.kv_heads == 1
                and args.head_size == 128
                and args.block_size == 16
            ),
            batch_invariant=False,
        )
        within_hard_fp32_tolerance = (
            math.isfinite(candidate_error.maximum)
            and candidate_error.maximum <= args.max_abs_error
            and candidate_error.p99 <= args.p99_abs_error
            and candidate_error.mean <= args.mean_abs_error
        )
        within_2d_fp32_envelope = (
            candidate_error.maximum
            <= max(
                baseline_error.maximum * args.baseline_envelope_slack,
                1e-5,
            )
            and candidate_error.p99
            <= max(
                baseline_error.p99 * args.baseline_envelope_slack,
                1e-5,
            )
            and candidate_error.mean
            <= max(
                baseline_error.mean * args.baseline_envelope_slack,
                1e-6,
            )
        )
        invalid_reasons: list[str] = []
        if planned_segmented is not candidate.segmented:
            invalid_reasons.append("planner route does not match candidate")
        if scratch_touched is not candidate.segmented:
            invalid_reasons.append("observed scratch touch does not match route")
        if not scratch_validation_complete:
            invalid_reasons.append("dedicated scratch validation is incomplete")
        if not bool(torch.isfinite(output).all().item()):
            invalid_reasons.append("output contains NaN or Inf")
        if not within_hard_fp32_tolerance:
            invalid_reasons.append("output exceeds declared FP32 tolerance")
        if not within_2d_fp32_envelope:
            invalid_reasons.append("output exceeds current 2D FP32 envelope")
        valid = not invalid_reasons
        median_ms = float(statistics.median(samples))
        backend_selectable = candidate.segments in (0, 16) and candidate.block_m == 16
        results.append(
            Result(
                candidate=candidate.name,
                planned_segmented=planned_segmented,
                scratch_touched=scratch_touched,
                scratch_validation_complete=scratch_validation_complete,
                backend_selectable=backend_selectable,
                segments=candidate.segments,
                warps=candidate.warps,
                block_m=candidate.block_m,
                median_ms=median_ms,
                mad_ms=_median_abs_deviation(samples),
                minimum_ms=float(min(samples)),
                maximum_ms=float(max(samples)),
                samples_ms=samples,
                speedup_vs_2d=(float(baseline_median / median_ms) if valid else None),
                error_vs_fp32=candidate_error,
                error_vs_2d=_error_stats(output, baseline_output),
                within_2d_fp32_envelope=within_2d_fp32_envelope,
                valid=valid,
                invalid_reasons=invalid_reasons,
            )
        )

    baseline_result = next(result for result in results if result.segments == 0)
    valid_segmented = [
        result.candidate for result in results if result.segments > 0 and result.valid
    ]
    valid_backend_segmented = [
        result.candidate
        for result in results
        if result.segments > 0 and result.valid and result.backend_selectable
    ]
    source_dirty = _source_dirty()
    source_gate_valid = not args.require_clean_source or not source_dirty
    overall_valid = (
        baseline_result.valid and bool(valid_backend_segmented) and source_gate_valid
    )
    env_keys = (
        "VLLM_SM70_TRITON_ATTN_PREFILL_TILE_SIZE",
        "VLLM_SM70_TRITON_ATTN_DECODE_TILE_SIZE",
        "VLLM_SM70_TRITON_ATTN_NUM_WARPS",
        "VLLM_SM70_TRITON_ATTN_PREFILL_NUM_WARPS",
        "VLLM_SM70_TRITON_ATTN_DECODE_NUM_WARPS",
        "VLLM_SM70_TRITON_ATTN_QK_INPUT_PRECISION",
        "VLLM_SM70_TRITON_ATTN_PV_INPUT_PRECISION",
        "VLLM_SM70_TRITON_ATTN_SAFE_DEFAULTS",
        "VLLM_BATCH_INVARIANT",
    )
    payload = {
        "valid": overall_valid,
        "evidence_scope": "operator_microbenchmark_non_terminal",
        "valid_segmented_candidates": valid_segmented,
        "valid_backend_selectable_candidates": valid_backend_segmented,
        "source": {
            "sha": _source_sha(),
            "dirty": source_dirty,
            "clean_required": args.require_clean_source,
            "content_sha256": _source_hashes(),
            "loaded_unified_attention": str(_loaded_source_path()),
            "command": [sys.executable, *sys.argv],
        },
        "environment": {key: os.environ.get(key) for key in env_keys},
        "device": {
            "name": torch.cuda.get_device_name(),
            "capability": list(torch.cuda.get_device_capability()),
            "torch": torch.__version__,
            "cuda": torch.version.cuda,
        },
        "shape": {
            "seq_lens": seq_lens,
            "query_lens": query_lens,
            "query_heads": args.query_heads,
            "kv_heads": args.kv_heads,
            "head_size": args.head_size,
            "block_size": args.block_size,
        },
        "seed": args.seed,
        "warmups": args.warmups,
        "repeats": args.repeats,
        "gates": {
            "max_abs_error": args.max_abs_error,
            "p99_abs_error": args.p99_abs_error,
            "mean_abs_error": args.mean_abs_error,
            "baseline_envelope_slack": args.baseline_envelope_slack,
        },
        "baseline_fp32_error": asdict(baseline_error),
        "results": [asdict(result) for result in results],
    }
    args.json_out.parent.mkdir(parents=True, exist_ok=True)
    args.json_out.write_text(json.dumps(payload, indent=2) + "\n")
    print(json.dumps(payload, indent=2))
    return 0 if overall_valid else 2


if __name__ == "__main__":
    raise SystemExit(main())
